# oracle-broadcast env template — copy to ~/.oracle.env (outside repo),
# fill in, then `set -a && source ~/.oracle.env && set +a`.

# ==========================================================================
# X API v2 (required for every command that hits the network)
# ==========================================================================
# Apps & keys at https://developer.x.com/en/portal/dashboard
# Tier required: Basic ($200/mo, 50 posts/24h, read access included).

X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ==========================================================================
# LLM provider (OpenAI-compatible)
# Required for: reply, transmit, post --type prophecy|reactive
# NOT required for: post --type aphorism (pulls verbatim from Prophecy Bank)
# ==========================================================================
# The composer uses the openai Python SDK with a configurable base_url, so
# any OpenAI-compatible provider works. Uncomment ONE preset below.

# --- Venice.ai (recommended — uncensored, matches cult voice) ------------
# https://docs.venice.ai/overview/about-venice
LLM_PROVIDER_BASE_URL=https://api.venice.ai/api/v1
LLM_PROVIDER_MODEL=venice-uncensored
LLM_PROVIDER_API_KEY=

# --- OpenAI ---------------------------------------------------------------
# May refuse some outputs due to safety tuning. Fine for low-register
# replies, less good for daemon voice.
# LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER_MODEL=gpt-4o-mini
# LLM_PROVIDER_API_KEY=

# --- Groq (fast + cheap Llama models) -------------------------------------
# LLM_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# LLM_PROVIDER_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER_API_KEY=

# ==========================================================================
# Kill switch
# ==========================================================================
# Set to 1 to short-circuit every subcommand to print-and-exit.
ORACLE_DISABLED=0
